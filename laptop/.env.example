# Copy to .env to change these. All optional: Commonplace runs fully offline without them.
# ./commonplace.sh start adds SECRETS_KEY to .env the first time; keep that line.

# Port on this laptop (http://localhost:8070).
# COMMONPLACE_PORT=8070

# Who can reach it. 127.0.0.1 = this computer only (the default). 0.0.0.0 = also other devices on
# your network, such as your iPhone on the same Wi-Fi (plain http: see the README first).
# COMMONPLACE_LISTEN=127.0.0.1

# Semantic search and related notes. hash (default) works offline with no model.
#   relaxai — needs RELAX_API_KEY (internet, UK, paid per use)
#   voyage  — needs VOYAGE_API_KEY (internet)
#   ollama  — a local Ollama on this computer (`ollama pull mxbai-embed-large`)
#   none    — keyword search only
# EMBEDDING_PROVIDER=hash
# RELAX_API_KEY=
# VOYAGE_API_KEY=
# OLLAMA_URL=http://host.docker.internal:11434

# Time zone for timestamps the server writes into notes.
# TIME_ZONE=Europe/London

# The storage guard: Commonplace refuses new data at 90% of this many GB. 0 turns it off.
# DB_DISK_GB=20

# true = anyone who can reach it can create an account. false = the admin invites people.
# ALLOW_SIGNUP=false

# Podman instead of Docker (picked automatically if Docker isn't installed).
# COMMONPLACE_ENGINE=podman
