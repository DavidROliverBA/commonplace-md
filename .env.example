# Postgres with the pgvector extension (docker compose maps it to 5434).
DATABASE_URL=postgres://commonplace:commonplace@localhost:5434/commonplace
PORT=3000

# Who may create accounts. The very first account is always allowed and becomes admin.
# false (the default) = invite-only: admins add people from Settings → Admin. true = anyone.
ALLOW_SIGNUP=false

# Embeddings for semantic search and "related notes". All three store vector(1024).
#   relaxai — Mistral-7b-embedding via relaxAI (UK datacentre, £0.20/M; needs RELAX_API_KEY)
#   voyage — voyage-4-lite via the Voyage API (best quality; needs VOYAGE_API_KEY)
#   ollama — mxbai-embed-large on a local Ollama (private; `ollama pull mxbai-embed-large`)
#   hash   — offline lexical hashing, no model at all (default; similarity is word overlap)
#   none   — keyword search only
EMBEDDING_PROVIDER=hash
# relaxai: Mistral-7b-embedding via relaxAI (UK, £); needs RELAX_API_KEY
RELAX_API_KEY=
VOYAGE_API_KEY=
OLLAMA_URL=http://localhost:11434

# Set when serving behind HTTPS so session cookies are marked Secure.
# Leave unset for plain-http LAN use (e.g. http://my-mac.local:3000 from an iPhone).
COOKIE_SECURE=

# Creating the first (admin) account requires this token. Empty = no check (fine on your own
# machine). In production, leaving it out entirely makes the server generate one and print it in
# the log until the first account exists.
SETUP_TOKEN=

# The database disk size in GB (Render's is set when the database is created). Admins see how
# full it is, and at 90% the server refuses new data so the disk never fills. Default 1; 0 turns
# the guard off.
DB_DISK_GB=

# Time zone for timestamps the server writes into notes (items shared from the iPhone).
TIME_ZONE=Europe/London

# Encrypts each person's AI API key and GitHub token at rest (bring your own AI, GitHub vaults). Any long random string, e.g.
# `openssl rand -base64 32`; on Render use the env var's Generate button. Changing it means
# everyone re-enters their key. Unset = assistants can't be added.
SECRETS_KEY=

# GitHub's API for GitHub vaults (F14). Leave unset; tests point it at a fake.
# GITHUB_API_URL=https://api.github.com

# Let assistants use a model served over plain http on this same machine (e.g. Ollama at
# http://localhost:11434/v1). Always allowed in development; off in production unless set.
ALLOW_LOCAL_AI=
