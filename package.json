{
  "name": "commonplace",
  "version": "0.0.45",
  "private": true,
  "description": "A multi-user Markdown knowledge base on Postgres + pgvector, with a web UI for laptop and iPhone.",
  "author": "David Oliver",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/server.ts",
    "start": "bun src/server.ts",
    "db:migrate": "bun src/migrate.ts",
    "db:up": "docker compose up -d db",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test",
    "test:ui": "bun test --timeout 30000 ./test/ui/editor.ui.ts",
    "screens": "bun test/ui/screens.ts",
    "help:shots": "bun test/ui/screens.ts screens --help",
    "bench": "bun scripts/bench.ts",
    "demo": "bun scripts/demo.ts",
    "standalone": "bun standalone/build.ts",
    "test:standalone": "bun test --timeout 30000 ./test/ui/standalone.ui.ts"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "acorn": "^8.15.0",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.16",
    "fflate": "^0.8.3",
    "jpeg-js": "0.4.4",
    "lib0": "^0.2.119",
    "libheif-js": "1.19.8",
    "luxon": "^3.7.2",
    "marked": "^18.1.0",
    "mermaid": "^11.17.2",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "y-codemirror.next": "^0.3.6",
    "y-indexeddb": "9.0.12",
    "y-protocols": "^1.0.7",
    "y-websocket": "^3.1.0",
    "yaml": "^2.9.1",
    "yjs": "^13.6.33",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.30.1",
    "@types/bun": "^1.4.2",
    "@types/luxon": "^3.7.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "4.10.3",
    "puppeteer-core": "^25.13.0",
    "typescript": "^7.0.2"
  }
}
